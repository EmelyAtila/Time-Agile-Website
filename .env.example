# Resend (envio de email) — usado em app/actions/contact.ts
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
CONTACT_EMAIL_TO=timeagile@gmail.com
# Remetente precisa ser de um domínio verificado no Resend (onboarding@resend.dev funciona só em teste)
CONTACT_EMAIL_FROM=Time Agile <onboarding@resend.dev>

# WhatsApp (somente dígitos, com DDI + DDD) — usado no botão flutuante, no Hero e no telefone dos dados estruturados
NEXT_PUBLIC_WHATSAPP_NUMBER=5561999999999

# Google Analytics (opcional; ainda não ligado no código). Ao ligar, atualizar a seção de cookies em
# content/legal.ts e pedir consentimento antes de carregar o script
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Site URL (usado em content/site.ts → metadata, robots, sitemap e dados estruturados)
# Em produção, o domínio real com https: sem ele o Google recebe endereços de localhost
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Google Search Console (opcional): só o código da meta "google-site-verification"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
